# ── Database (Neon Postgres) ──────────────────────────────────────────────
# pooled string (host contains -pooler) → used by the app
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# direct/unpooled string → used only by `npx prisma db push`
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── AI brain (Z.ai or any OpenAI-compatible provider) ────────────────────
AI_BASE_URL="https://api.z.ai/api/paas/v4"
AI_API_KEY="your-z-ai-api-key"
AI_CHAT_MODEL="glm-4.6"          # or glm-4-flash (very cheap)
AI_VISION_MODEL="glm-4.5v"       # reads chart screenshots in chat

# ── Optional upgrades ─────────────────────────────────────────────────────
# true spot XAU/USD candle history for the gold chart (free key, 800 calls/day)
# https://twelvedata.com
# TWELVE_DATA_API_KEY="your-twelve-data-key"

# whole-site login prompt (strongly recommended on a public deployment)
# APP_PASSWORD="a-strong-password"

# locks the daily cron endpoint so strangers can't trigger scans
# CRON_SECRET="a-random-string"
